<?xml version="1.0" encoding="utf-8"?>
<!-- Ni sauvegarde dans le nuage ni transfert d'appareil : les secrets sont
     chiffrés par une clé du Keystore qui, elle, ne se transfère pas. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
