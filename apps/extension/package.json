{
  "name": "oldtown-extension",
  "version": "1.0.0",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "build": "npm run wasm && ng build && node scripts/build-extension.mjs",
    "lint": "ng lint && prettier --check . && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run wasm && vitest run --config vitest.worker.config.mts && ng test --watch=false",
    "test:worker": "vitest run --config vitest.worker.config.mts",
    "format": "prettier --write .",
    "deploy": "bash scripts/deploy.sh"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  }
}
