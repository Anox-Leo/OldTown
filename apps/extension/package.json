{
  "name": "oldtown-extension",
  "version": "1.0.0",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "build": "npm run wasm && ng build && node scripts/build-extension.mjs",
    "lint": "eslint . && prettier --check . && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run wasm && vitest run --config vitest.worker.config.mts && ng test --watch=false",
    "test:worker": "vitest run --config vitest.worker.config.mts",
    "format": "prettier --write .",
    "lint:prune": "eslint . --prune-suppressions",
    "deploy": "bash scripts/deploy.sh"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "rxjs": "~7.8.0",
    "tldts": "^7.4.22",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.1.0"
  }
}
