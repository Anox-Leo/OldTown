{
  "manifest_version": 3,
  "name": "OldTown",
  "version": "0.1.0",
  "description": "Envoyer pages, liens et textes entre mes appareils, chiffrés de bout en bout.",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "OldTown",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardRead",
    "contextMenus",
    "notifications",
    "offscreen",
    "storage"
  ],
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Envoyer la page au dernier destinataire"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
