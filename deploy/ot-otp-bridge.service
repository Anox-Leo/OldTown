[Unit]
Description=OldTown : codes d'otp-relay vers mes appareils
Wants=otp-relay.service
After=otp-relay.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=OT_HOME=%h/.local/share/oldtown-otp
EnvironmentFile=%h/.config/oldtown-otp/bridge.env
ExecStart=%h/.local/bin/ot otp-bridge
Restart=always
RestartSec=10
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=%h/.local/share/oldtown-otp
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=default.target
