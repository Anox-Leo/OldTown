[Unit]
Description=Diagnostic du relais OldTown (%i)
Documentation=file:///usr/local/share/doc/oldtown/README.md
Wants=network-online.target
After=network-online.target tailscaled.service ot-server.service
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=oneshot
User=ot-diag
Group=ot-diag
SupplementaryGroups=systemd-journal
Environment=OT_HOME=/var/lib/ot-diag/ot
EnvironmentFile=-/etc/oldtown/diag.env
ExecStart=/usr/local/lib/oldtown/ot-diag.sh %i
Restart=on-failure
RestartSec=2min
TimeoutStartSec=20min

StateDirectory=ot-diag
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
