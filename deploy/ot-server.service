[Unit]
Description=Relais OldTown
Documentation=file:///usr/local/share/doc/oldtown/README.md
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=exec
User=ot-relay
Group=ot-relay
ExecStart=/usr/local/bin/ot-server serve
Environment=OT_LISTEN=127.0.0.1:7878
Environment=OT_ADMIN_LISTEN=127.0.0.1:7879
Environment=OT_DB=/var/lib/ot-relay/ot.db
Environment=OT_TTL=7d
Environment=OT_LOG_FORMAT=json
Restart=on-failure
RestartSec=5

StateDirectory=ot-relay
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
